    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Include="Reqnroll.MSTest" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AppDtos/AppDtos.csproj" />
    <ProjectReference Include="../Petstore.Api.Tests.Data/Petstore.Api.Tests.Data.csproj" />
    <ProjectReference Include="../Petstore.Api.Tests.Infrastructure/Petstore.Api.Tests.Infrastructure.csproj" />
    <ProjectReference Include="../Petstore.Api.Tests.Services/Petstore.Api.Tests.Services.csproj" />
  </ItemGroup>
</Project>
